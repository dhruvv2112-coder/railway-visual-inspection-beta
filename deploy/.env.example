# Long random value; changing it signs everyone out.  Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
RVI_SECRET_KEY=
# token = ID + PIN sign-in (production). header = development only, trusts the app's X-Actor/X-Role headers.
RVI_AUTH_MODE=token
RVI_TOKEN_HOURS=12
# Optional: URL that receives a JSON POST for every urgent finding (e.g. an SMS or chat gateway)
RVI_ALERT_WEBHOOK=
# Optional: read-only GitHub token (fine-grained, Contents: read) so phones get each new app build automatically
RVI_GITHUB_TOKEN=
